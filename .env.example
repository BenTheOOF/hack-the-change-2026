# Supabase project URL. The Connect button at the top of your project dashboard shows it.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Project Settings > API Keys.
# Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). Project Settings > API Keys.
# Backend only. It bypasses row-level security.
SUPABASE_SECRET_KEY=

# Where the browser and the Next.js server find the FastAPI backend.
# Use 127.0.0.1, not localhost: Node can resolve localhost to IPv6 and miss the API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public address of the web app, used for sign-in and sign-out redirects.
# Leave empty locally. In production set it to your domain (https://app.example.com);
# otherwise the app falls back to the proxy's Host header.
SITE_URL=

# Browser origins the API accepts, comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM provider, called through the OpenAI-compatible Chat Completions API (POST {LLM_BASE_URL}/chat/completions).
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI:     https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Key for that provider (for Gemini, an API key from Google AI Studio). Backend only.
# Leave empty to disable /ai/chat.
LLM_API_KEY=

# Model id to call. Look up a current id in the provider docs and paste it here.
# Left empty on purpose: /ai/chat answers 503 until you set it.
LLM_MODEL=

# Upper limit on tokens generated per /ai/chat request.
LLM_MAX_TOKENS=512

# Comma-separated emails that become admins the first time they sign in with Google.
# Only Google-verified accounts qualify (password sign-ups are not email-confirmed here).
# For a password-only admin, run backend/supabase/admin-grant.sql instead.
ADMIN_EMAILS=

# Local ports. scripts/worktree.sh picks different ones for each worktree.
WEB_PORT=3000
API_PORT=8000
